{
  "_provenance": {
    "purpose": "Field-level answer key for the M6 live-extraction evaluation. Complements evaluation/ground_truth.json (decision-level, Checkpoint G).",
    "method": "Each value was read from the text of the corresponding PDF in assessment-data/ (the pdf_reader text of each pack) against company-rules.md. No fixture, LLM output or pipeline output was used to create or check a value. The arithmetic block is plain Decimal arithmetic on the printed line values (quantity x unit price; VAT = recalculated subtotal x printed rate; total = recalculated subtotal + VAT), not the output of src/arithmetic.py.",
    "author_note": "Drafted by an AI assistant (Claude), not by a human reading the PDFs, and NOT yet independently reviewed by the project owner. Review every value against the PDFs before treating it as authoritative. Disclosure: before drafting, the assistant had viewed the first 3,500 characters of fixtures/mock_llm_responses/supplier-pack-01.json while inspecting the data format; every pack-01 value here was re-read from the PDF text.",
    "null_meaning": "null means the PDF does not state the value, so the correct extraction is 'not found' (null / UNKNOWN / ABSENT). A model that returns a value for a null field is scored SPURIOUS.",
    "penalty_present": "true = a late-delivery penalty clause exists; false = the PDF has none (the correct state is ABSENT).",
    "line_totals": "line_total_bdt, subtotal_bdt, vat_amount_bdt and grand_total_bdt are the PRINTED values, even where they are arithmetically wrong (pack 09).",
    "units": "money as decimal strings; percentages as percentage points ('15' = 15%); periods in days; payment_min_days/payment_max_days are the balance/full-payment period (a range for pack 09).",
    "arithmetic_scope": "Pack 10 prints no Subtotal/VAT/Total-with-VAT rows (all taxes included), so only line_recalc is scored for it.",
    "created": "2026-11-04"
  },
